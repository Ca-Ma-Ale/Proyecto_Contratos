# Copia este archivo como .env en el VPS.
# Para conservar datos cifrados, usa la misma SECRET_KEY de PythonAnywhere si
# no tenias ENCRYPTION_KEY configurada alla.

SECRET_KEY=pega-la-secret-key-de-pythonanywhere-o-una-nueva-si-no-hay-datos-cifrados
DEBUG=False
SECURE_SSL_REDIRECT=False
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com,IP_DEL_SERVIDOR
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

DATABASE_NAME=nombre_bd
DATABASE_USER=usuario_bd
DATABASE_PASSWORD=clave_mysql_segura
MYSQL_ROOT_PASSWORD=clave_root_mysql_segura
DATABASE_HOST=mysql
DATABASE_PORT=3306

# Si ya existia en PythonAnywhere, copia el mismo valor.
ENCRYPTION_KEY=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
